{
  "openapi": "3.0.0",
  "info": {
    "title": "Student API",
    "version": "1.0.0"
  },
  "paths": {
    "/student": {
      "get": {
        "responses": {
          "200": {
            "description": "Student data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "rollNo": { "type": "integer" },
                    "email": { "type": "string" }
                  },
                  "required": ["name", "rollNo", "email"]
                }
              }
            }
          }
        }
      }
    }
  }
}
